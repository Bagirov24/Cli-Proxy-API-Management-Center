{
    # Railway terminates public HTTPS; private Core traffic uses Railway networking.
    admin off
    auto_https off
    persist_config off

    servers :8080 {
        max_header_size 16KiB
        timeouts {
            read_header 10s
            read_body_idle 30s
            write_idle 10m
            idle 2m
        }
    }
}

:8080 {
    # Never write request bodies or credential headers to an access log.
    header {
        -Server
        X-Content-Type-Options nosniff
        Cache-Control "no-store"
    }

    @health {
        method GET
        path /healthz
    }
    handle @health {
        respond "ok" 200
    }

    # Only POST chat/responses and GET models are exposed.
    @public_api `(method('POST') && path('/v1/chat/completions', '/v1/responses')) || (method('GET') && path('/v1/models'))`

    # Header shape screening, NOT authentication. Real CPA key verification,
    # model allowlisting and per-key RPM remain exclusively in the private Core.
    # Query-string keys and native API keys are intentionally not allowed publicly.
    # Retain header variants supported by CPA's key-policy plugin.
    @bad_credential `!(header_regexp('auth_bearer', 'Authorization', '(?i)^Bearer cpa_[A-Za-z0-9_-]{43}$') || header_regexp('auth_x_api_key', 'X-API-Key', '^cpa_[A-Za-z0-9_-]{43}$') || header_regexp('auth_api_key', 'api-key', '^cpa_[A-Za-z0-9_-]{43}$') || header_regexp('auth_google', 'x-goog-api-key', '^cpa_[A-Za-z0-9_-]{43}$'))`

    handle @public_api {
        # 'route' fixes handler ordering: rate limit -> reject malformed
        # credentials -> size cap -> private reverse proxy. A rejected request
        # cannot reach Core. The synthetic key used in CI is NEVER valid in Core.
        route {
            rate_limit {
                zone gateway_per_ip {
                    # Railway overwrites X-Real-IP at its public edge.
                    # On PRIVATE ingress, this header is not trustworthy.
                    key {http.request.header.X-Real-IP}
                    window 1m
                    events {$EDGE_IP_RPM:180}
                    ipv6_prefix 64
                }
                zone gateway_global {
                    key all_public_api
                    window 1m
                    events {$EDGE_GLOBAL_RPM:600}
                }
                # Avoid per-IP label cardinality in Prometheus.
                disable_metrics
            }

            respond @bad_credential "Unauthorized" 401

            request_body {
                max_size 16MiB
            }
            reverse_proxy http://cliproxyapi-core.railway.internal:8317 {
                header_up -Forwarded
                header_up -X-Original-URL
                header_up -X-Rewrite-URL
                header_up -X-HTTP-Method-Override
                transport http {
                    dial_timeout 5s
                    response_header_timeout 5m
                }
                # SSE must be streamed; no buffering, no POST retries.
            }
        }
    }

    handle {
        respond "Not Found" 404
    }
}
